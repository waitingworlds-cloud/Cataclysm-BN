; Engine configuration file.
; Bright Nights front end: Godot owns the window and draws the interface,
; the game runs as a background process (see README.md).

config_version=5

[application]

config/name="Cataclysm: Bright Nights"
config/description="Modern front end for Cataclysm: Bright Nights"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0627451, 0.0823529, 0.109804, 1)
boot_splash/show_image=false

[autoload]

Bridge="*res://src/bridge.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/resizable=true
window/stretch/mode="disabled"
window/energy_saving/keep_screen_on=false

[gui]

common/drop_mouse_on_gui_input_disabled=true
timers/tooltip_delay_sec=0.25

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0627451, 0.0823529, 0.109804, 1)
textures/canvas_textures/default_texture_filter=1
